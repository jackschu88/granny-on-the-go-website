# Copy to .env.local for local dev.
# On Vercel: Project → Settings → Environment Variables (Production + Preview).

# Gumroad pre-order products
# Standard ($15.99) — full URL optional; slug rsmfcb is hardcoded as fallback
NEXT_PUBLIC_GUMROAD_URL=https://theveilpress.gumroad.com/l/rsmfcb
# Signed copy ($20.99) — slug wizffl is hardcoded; env can override
NEXT_PUBLIC_GUMROAD_SIGNED_SLUG=wizffl

# Contact / notify emails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Granny on the Go <onboarding@resend.dev>
CONTACT_TO_EMAIL=GrannyOnTheGoBooks@gmail.com

# Optional later
NEXT_PUBLIC_AMAZON_URL=
